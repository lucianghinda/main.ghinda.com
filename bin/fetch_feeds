#!/usr/bin/env ruby
# frozen_string_literal: true

# Aggregates external RSS/Atom feeds into _data/external_posts.yml so the
# homepage can merge them with local posts at build time. Run before deploying:
#
#   bundle exec bin/fetch_feeds
#
# Design notes:
#   * Offline/robustness — on a feed failure it keeps that source's previously
#     committed items instead of dropping them, and never clobbers a good file
#     with nothing. The build stays deterministic and works with no network.
#   * Dates are written as unquoted ISO 8601 Time scalars (via Psych) so Jekyll
#     reads them back as Time, keeping them sortable against local post dates in
#     Liquid (`site.posts | concat: externals | sort: "date"`).
#   * Each item also gets a "markdown_url" when the source site serves a raw .md
#     sibling, checked here with a HEAD request. llms.txt links to it. Deriving
#     and verifying the URL here rather than in Liquid is deliberate: Liquid
#     silently passes values through unknown filters, so a bad URL there ships
#     dead links on a green build. Items whose .md is missing keep only "url",
#     and llms.txt falls back to the HTML page for them.

require "net/http"
require "uri"
require "rss"
require "yaml"
require "time"
require "fileutils"

FEEDS = {
  "notes"          => "https://notes.ghinda.com/feed.atom",
  "allaboutcoding" => "https://allaboutcoding.ghinda.com/rss.xml"
}.freeze

DATA_FILE = File.expand_path("../_data/external_posts.yml", __dir__)
MAX_PER_FEED = 12
DESC_LIMIT = 160
USER_AGENT = "ghinda-blog-feed-fetcher"
PROBE_TIMEOUT = 5
PROBE_CONCURRENCY = 8

def fetch(url, redirects = 3)
  uri = URI.parse(url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == "https"
  http.open_timeout = 10
  http.read_timeout = 10
  req = Net::HTTP::Get.new(uri.request_uri, "User-Agent" => USER_AGENT)
  res = http.request(req)

  case res
  when Net::HTTPSuccess
    res.body
  when Net::HTTPRedirection
    raise "too many redirects" if redirects <= 0

    fetch(URI.join(url, res["location"]).to_s, redirects - 1)
  else
    raise "HTTP #{res.code}"
  end
end

def to_time(value)
  return nil if value.nil?
  return value if value.is_a?(Time)

  raw = value.respond_to?(:content) ? value.content : value
  return raw if raw.is_a?(Time)

  Time.parse(raw.to_s)
rescue ArgumentError, TypeError
  nil
end

def clean_description(text)
  return nil if text.nil?

  clean = text.to_s.gsub(/<[^>]+>/, " ").gsub(/\s+/, " ").strip
  return nil if clean.empty?
  return clean if clean.length <= DESC_LIMIT

  "#{clean[0, DESC_LIMIT].sub(/\s+\S*\z/, '')}…"
end

def atom_link(entry)
  link = entry.link
  href = link.respond_to?(:href) ? link.href : nil
  href ||= entry.links.map(&:href).compact.first if entry.respond_to?(:links)
  href
end

# Raw-Markdown sibling of a post URL: drop any query and fragment, strip
# trailing slashes, then append ".md". allaboutcoding serves its post URLs with
# a trailing slash and notes without, so both shapes must land on the same file.
def markdown_candidate(url)
  uri = URI.parse(url)
  return nil unless uri.is_a?(URI::HTTP)

  uri.query = nil
  uri.fragment = nil
  path = uri.path.sub(%r{/+\z}, "")
  return nil if path.empty?

  uri.path = path.end_with?(".md") ? path : "#{path}.md"
  uri.to_s
rescue URI::InvalidURIError
  nil
end

# :ok, :missing, or :unknown. :unknown means the check itself failed (timeout,
# DNS, 5xx), so the caller keeps whatever the previous run recorded rather than
# downgrading a good link because the network blipped.
def probe(url, method = Net::HTTP::Head, redirects = 2)
  uri = URI.parse(url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == "https"
  http.open_timeout = PROBE_TIMEOUT
  http.read_timeout = PROBE_TIMEOUT
  res = http.request(method.new(uri.request_uri, "User-Agent" => USER_AGENT))

  case res
  when Net::HTTPSuccess then :ok
  when Net::HTTPRedirection
    return :unknown if redirects <= 0

    probe(URI.join(url, res["location"]).to_s, method, redirects - 1)
  when Net::HTTPMethodNotAllowed
    method == Net::HTTP::Head ? probe(url, Net::HTTP::Get, redirects) : :missing
  when Net::HTTPServerError then :unknown
  else :missing
  end
rescue StandardError
  :unknown
end

def cached_markdown_urls(cached)
  cached.values.flatten.each_with_object({}) do |item, map|
    map[item["url"]] = item["markdown_url"] if item["url"] && item["markdown_url"]
  end
end

# Sets "markdown_url" on every item whose .md sibling actually responds, and
# returns the per-URL status for reporting. Batched so one unresponsive host
# cannot stall the whole run.
def attach_markdown_urls!(items, previous)
  statuses = {}
  lock = Mutex.new

  items.each_slice(PROBE_CONCURRENCY) do |batch|
    batch.map do |item|
      Thread.new do
        candidate = markdown_candidate(item["url"])
        status = candidate ? probe(candidate) : :missing
        resolved = status == :ok ? candidate : (previous[item["url"]] if status == :unknown)
        item["markdown_url"] = resolved if resolved
        lock.synchronize { statuses[item["url"]] = status }
      end
    end.each(&:join)
  end

  statuses
end

def normalize(feed, source)
  items =
    if feed.is_a?(RSS::Atom::Feed)
      feed.entries.map do |e|
        {
          "title"       => e.title&.content.to_s.strip,
          "url"         => atom_link(e),
          "description" => clean_description((e.summary || e.content)&.content),
          "source"      => source,
          "date"        => to_time(e.published || e.updated)
        }
      end
    else
      feed.items.map do |i|
        {
          "title"       => i.title.to_s.strip,
          "url"         => i.link.to_s,
          "description" => clean_description(i.description),
          "source"      => source,
          "date"        => to_time(i.date || i.pubDate)
        }
      end
    end

  items.reject { |it| it["url"].to_s.empty? || it["title"].empty? || it["date"].nil? }
end

def load_cached
  return {} unless File.exist?(DATA_FILE)

  data = YAML.safe_load_file(DATA_FILE, permitted_classes: [Time]) || []
  data.group_by { |it| it["source"] }
rescue StandardError => e
  warn "warning: could not read existing #{DATA_FILE} (#{e.message})"
  {}
end

cached = load_cached
result = {}

FEEDS.each do |source, url|
  items = normalize(RSS::Parser.parse(fetch(url), false), source).first(MAX_PER_FEED)
  if items.empty?
    warn "warning: #{source} returned no usable items; keeping cached copy"
    result[source] = cached[source] || []
  else
    result[source] = items
    puts "fetched #{items.size} items from #{source}"
  end
rescue StandardError => e
  warn "warning: failed to fetch #{source} (#{e.message}); keeping cached copy"
  result[source] = cached[source] || []
end

all = result.values.flatten.sort_by { |it| it["date"] }.reverse

if all.empty?
  warn "error: no items from any source and no cache; leaving #{DATA_FILE} unchanged"
  exit 0
end

statuses = attach_markdown_urls!(all, cached_markdown_urls(cached))
missing  = statuses.select { |_, s| s == :missing }.keys
unknown  = statuses.select { |_, s| s == :unknown }.keys
puts "verified .md siblings for #{statuses.count { |_, s| s == :ok }}/#{all.size} items"

unless missing.empty?
  warn "warning: no .md sibling for #{missing.size} item(s); llms.txt will link to the HTML page:"
  missing.each { |url| warn "  #{url}" }
end

unless unknown.empty?
  warn "warning: could not check #{unknown.size} item(s); kept the previous value where there was one:"
  unknown.each { |url| warn "  #{url}" }
end

FileUtils.mkdir_p(File.dirname(DATA_FILE))
File.write(DATA_FILE, all.to_yaml)
puts "wrote #{all.size} items to #{DATA_FILE}"
